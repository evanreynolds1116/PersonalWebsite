---
import { hireLink, navLinks, site } from '../config/site';
import Button from './Button.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!-- Sticky on phones (as in the phone mockup), static on desktop. -->
<header class="sticky top-0 z-20 border-b border-border bg-bg md:static">
  <nav
    aria-label="Main"
    class="mx-auto flex max-w-content items-center justify-between gap-3 px-5 py-2.5 font-mono text-[15px] md:gap-4 md:px-6 md:py-5"
  >
    <a href="/" class="flex min-h-11 items-center font-bold text-text">
      <span class="text-accent">~/</span>
      {site.handle}
    </a>

    <div class="flex items-center gap-2 md:gap-6">
      <ul class="hidden md:flex md:items-center md:gap-6">
        {navLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrent(href) ? 'page' : undefined}
              class="text-muted aria-[current=page]:text-text"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <ThemeToggle />

      <!-- Wrapped so the display toggle doesn't fight Button's own inline-flex. -->
      <div class="hidden md:block">
        <Button href={hireLink.href} size="sm">
          {hireLink.label}
        </Button>
      </div>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-lg border border-border bg-transparent text-text md:hidden"
      >
        <svg
          class="icon-open"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
        <svg
          class="icon-close"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="max-h-[calc(100dvh-4rem)] overflow-y-auto border-t border-border px-5 pt-2 pb-6 font-mono text-base md:hidden"
  >
    <ul>
      {navLinks.map(({ label, href }) => (
        <li class="border-b border-border">
          <a
            href={href}
            aria-current={isCurrent(href) ? 'page' : undefined}
            class="flex min-h-11 items-center py-3"
          >
            <span class="text-accent" aria-hidden="true">
              $&nbsp;
            </span>
            cd {label}
          </a>
        </li>
      ))}
    </ul>
    <Button href={hireLink.href} class="mt-4 w-full">
      {hireLink.label}
    </Button>
  </div>
</header>

<style>
  .icon-close,
  #menu-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  #menu-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Escape closes the menu and returns focus to the button.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Close on in-page jumps (e.g. #contact) and when tapping outside the header.
    menu.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !(event.target as Element).closest('header')) setOpen(false);
    });

    // The panel is phone-only; reset it when the viewport grows to desktop.
    window.matchMedia('(width >= 48rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
