---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src?: ImageMetadata | undefined;
  alt?: string | undefined;
  /** Placeholder height classes, used until a real screenshot is set. */
  placeholderClass?: string;
  placeholder?: string;
  /** Rendered widths for responsive srcset; the largest should match the widest layout. */
  widths?: number[];
  sizes?: string;
  /** Set on the above-the-fold hero image only. */
  priority?: boolean;
}

const {
  src,
  alt = '',
  placeholderClass = 'h-[170px] md:h-[180px]',
  placeholder = '[screenshot]',
  widths = [400, 700],
  sizes = '(min-width: 768px) 350px, 100vw',
  priority = false,
} = Astro.props;
---

{src ? (
  <Picture
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="block h-auto w-full bg-bg"
  />
) : (
  <div
    class:list={[
      'flex items-center justify-center bg-bg font-mono text-[13px] text-muted md:text-sm',
      placeholderClass,
    ]}
  >
    {placeholder}
  </div>
)}
