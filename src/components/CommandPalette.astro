---
/**
 * Cmd+K / Ctrl+K command palette: a keyboard shortcut to jump to any page or
 * project, or run a small action. A power-user extra; every destination is also
 * reachable through normal navigation.
 *
 * Built on <dialog>, so the browser handles the focus trap, Escape and restoring
 * focus. The list is rendered here at build time; the script only filters it.
 */
import { navLinks, site } from '../config/site';
import { getProjects, projectHref } from '../lib/projects';

interface Command {
  id: string;
  label: string;
  /** Right-aligned hint, e.g. the URL. */
  hint: string;
  /** Extra words that should match, e.g. a project's stack. */
  keywords?: string;
  href?: string;
  /** A built-in action instead of a link. */
  action?: 'toggle-theme' | 'copy-email';
  download?: boolean;
}

const projects = await getProjects();

const groups: { name: string; commands: Command[] }[] = [
  {
    name: 'pages',
    commands: [
      { id: 'home', label: 'cd ~', hint: '/', keywords: 'home', href: '/' },
      ...navLinks.map((link) => ({
        id: link.label,
        label: `cd ${link.label}`,
        hint: link.href,
        href: link.href,
      })),
      {
        id: 'contact',
        label: 'cd contact',
        hint: '/contact',
        keywords: 'hire email',
        href: '/contact',
      },
      { id: 'uses', label: 'cd uses', hint: '/uses', keywords: 'setup tools', href: '/uses' },
    ],
  },
  {
    name: 'projects',
    commands: projects.map((project) => ({
      id: `project-${project.id}`,
      label: `open ${project.data.title}`,
      hint: projectHref(project),
      keywords: `${project.id} ${project.data.stack.join(' ')} case study`,
      href: projectHref(project),
    })),
  },
  {
    name: 'actions',
    commands: [
      {
        id: 'resume-pdf',
        label: './download-resume',
        hint: 'pdf',
        keywords: 'cv',
        href: '/resume.pdf',
        download: true,
      },
      {
        id: 'theme',
        label: 'toggle theme',
        hint: 'dark / light',
        keywords: 'mode',
        action: 'toggle-theme',
      },
      { id: 'copy-email', label: 'copy email', hint: site.email, action: 'copy-email' },
      { id: 'mailto', label: 'email me', hint: 'mailto', href: `mailto:${site.email}` },
      ...(site.github
        ? [{ id: 'github', label: 'open github', hint: '↗', href: site.github }]
        : []),
      ...(site.linkedin
        ? [{ id: 'linkedin', label: 'open linkedin', hint: '↗', href: site.linkedin }]
        : []),
    ],
  },
];
---

<dialog
  id="cmdk"
  aria-labelledby="cmdk-title"
  data-email={site.email}
  class="m-auto mt-[12vh] w-[min(640px,calc(100vw-32px))] max-w-none overflow-hidden rounded-xl border border-border bg-surface p-0 text-text shadow-2xl backdrop:bg-black/60 print:hidden"
>
  <h2 id="cmdk-title" class="sr-only">
    Command palette
  </h2>
  <div class="flex items-center gap-3 border-b border-border px-4 font-mono text-base">
    <span class="text-accent" aria-hidden="true">
      $
    </span>
    <input
      id="cmdk-input"
      type="text"
      role="combobox"
      aria-label="Jump to a page or run a command"
      aria-expanded="true"
      aria-controls="cmdk-list"
      aria-autocomplete="list"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="type a page, project or command…"
      class="min-h-14 w-full bg-transparent text-text placeholder:text-muted focus:outline-none"
    />
    <kbd class="rounded border border-border px-1.5 py-0.5 text-xs text-muted">esc</kbd>
  </div>

  <div id="cmdk-list" role="listbox" aria-label="Commands" class="max-h-[50vh] overflow-y-auto p-2">
    {groups.map((group) => (
      <div role="group" aria-labelledby={`cmdk-group-${group.name}`} data-cmdk-group>
        <div id={`cmdk-group-${group.name}`} class="px-2 pt-2 pb-1 font-mono text-xs text-muted">
          {`# ${group.name}`}
        </div>
        {group.commands.map((command) => (
          <div
            id={`cmdk-${command.id}`}
            role="option"
            aria-selected="false"
            data-cmdk-item
            data-search={`${command.label} ${command.hint} ${command.keywords ?? ''}`.toLowerCase()}
            data-href={command.href}
            data-action={command.action}
            data-download={command.download ? '' : undefined}
            class="flex min-h-11 cursor-pointer items-center justify-between gap-4 rounded-lg px-3 font-mono text-[15px] aria-selected:bg-bg aria-selected:text-accent"
          >
            <span class="truncate">{command.label}</span>
            <span class="shrink-0 truncate text-[13px] text-muted">{command.hint}</span>
          </div>
        ))}
      </div>
    ))}
    <p id="cmdk-empty" hidden class="px-3 py-4 font-mono text-sm text-muted">
      zsh: command not found: <span class="text-highlight" id="cmdk-empty-query"></span>
    </p>
  </div>

  <p
    class="hidden gap-4 border-t border-border px-4 py-2.5 font-mono text-xs text-muted md:flex"
    aria-hidden="true"
  >
    <span>↑↓ select</span>
    <span>↵ open</span>
    <span>esc close</span>
  </p>
</dialog>

<!-- Announcements and the "copied" toast live outside the dialog so they survive it closing. -->
<p id="cmdk-status" role="status" class="sr-only"></p>
<p
  id="cmdk-toast"
  hidden
  class="fixed bottom-6 left-1/2 z-50 -translate-x-1/2 rounded-lg border border-border bg-surface px-4 py-2.5 font-mono text-sm shadow-lg print:hidden"
></p>

<script>
  import { applyTheme, getTheme, storeTheme } from '../lib/theme';

  interface Elements {
    dialog: HTMLDialogElement;
    input: HTMLInputElement;
    empty: HTMLElement;
    emptyQuery: HTMLElement;
    status: HTMLElement;
    toast: HTMLElement;
  }

  function initPalette({ dialog, input, empty, emptyQuery, status, toast }: Elements) {
    const items = [...dialog.querySelectorAll<HTMLElement>('[data-cmdk-item]')];
    const groups = [...dialog.querySelectorAll<HTMLElement>('[data-cmdk-group]')];
    let visible = items;
    let active = 0;
    let toastTimer: number | undefined;

    const select = (index: number) => {
      items.forEach((item) => item.setAttribute('aria-selected', 'false'));
      if (visible.length === 0) {
        input.removeAttribute('aria-activedescendant');
        return;
      }
      active = (index + visible.length) % visible.length;
      const current = visible[active];
      if (!current) return;
      current.setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', current.id);
      current.scrollIntoView({ block: 'nearest' });
    };

    // Every space-separated term must appear in the command's label, hint or keywords.
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      const terms = query.split(/\s+/).filter(Boolean);
      visible = items.filter((item) => {
        const match = terms.every((term) => (item.dataset.search ?? '').includes(term));
        item.hidden = !match;
        return match;
      });
      groups.forEach((group) => {
        group.hidden = !group.querySelector('[data-cmdk-item]:not([hidden])');
      });
      empty.hidden = visible.length > 0;
      emptyQuery.textContent = query;
      select(0);
    };

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      filter();
      dialog.showModal();
      input.focus();
    };

    const notify = (message: string) => {
      status.textContent = message;
      toast.textContent = `✓ ${message}`;
      toast.hidden = false;
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.hidden = true;
      }, 2000);
    };

    const run = async (item: HTMLElement | undefined) => {
      if (!item) return;
      dialog.close();
      const { href, action } = item.dataset;

      if (action === 'toggle-theme') {
        const next = getTheme() === 'dark' ? 'light' : 'dark';
        applyTheme(next);
        storeTheme(next);
        notify(`${next} theme`);
      } else if (action === 'copy-email') {
        const email = dialog.dataset.email ?? '';
        try {
          await navigator.clipboard.writeText(email);
          notify(`copied ${email}`);
        } catch {
          notify(`email: ${email}`);
        }
      } else if (href) {
        if (item.hasAttribute('data-download')) {
          const link = document.createElement('a');
          link.href = href;
          link.download = '';
          link.click();
        } else {
          window.location.href = href;
        }
      }
    };

    // Reveal the footer trigger(s) now that JS is running, with the right shortcut label.
    const isMac = /mac|iphone|ipad/i.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll<HTMLElement>('[data-cmdk-open]').forEach((trigger) => {
      trigger.hidden = false;
      const label = trigger.querySelector('[data-cmdk-key]');
      if (label) label.textContent = isMac ? '⌘K' : 'Ctrl K';
      trigger.addEventListener('click', open);
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
      }
    });

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        select(active + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        select(active - 1);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        void run(visible[active]);
      }
    });

    items.forEach((item) => {
      item.addEventListener('mousemove', () => {
        const index = visible.indexOf(item);
        if (index !== active) select(index);
      });
      item.addEventListener('click', () => void run(item));
    });

    // Clicking the backdrop (the dialog element itself, outside its content) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  const dialog = document.getElementById('cmdk');
  const input = document.getElementById('cmdk-input');
  const empty = document.getElementById('cmdk-empty');
  const emptyQuery = document.getElementById('cmdk-empty-query');
  const status = document.getElementById('cmdk-status');
  const toast = document.getElementById('cmdk-toast');

  if (
    dialog instanceof HTMLDialogElement &&
    input instanceof HTMLInputElement &&
    empty &&
    emptyQuery &&
    status &&
    toast
  ) {
    initPalette({ dialog, input, empty, emptyQuery, status, toast });
  }
</script>
