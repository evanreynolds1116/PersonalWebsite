---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import Flags from '../components/Flags.astro';
import PageHeader from '../components/PageHeader.astro';
import PromptHeading from '../components/PromptHeading.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dateRange, resume, year } from '../lib/resume';

const { basics, work, education, certificates, skills } = resume;
const location = [basics.location.city, basics.location.region].filter(Boolean).join(', ');
const contactLine = [location, basics.email, site.github, site.linkedin]
  .filter((item): item is string => Boolean(item))
  .map((item) => item.replace(/^https?:\/\/(www\.)?/, ''));
---

<BaseLayout
  title="Resume"
  description={`${basics.label}. Experience, skills and education.`}
  footerFile="resume.json"
>
  <Container class="pb-14 md:pb-24">
    <PageHeader path="~/resume" command="cat resume.json" title={basics.name} lead={basics.label}>
      <!-- Print shows contact details in place of the buttons. -->
      <p class="hidden font-mono text-sm print:block">{contactLine.join(' · ')}</p>
      <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-4 print:hidden">
        <!-- Phase 3 swaps this for a build-time PDF download. -->
        <button
          type="button"
          id="print-resume"
          hidden
          class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-lg bg-accent px-5 py-3 font-mono text-[15px] font-bold text-on-accent"
        >
          print / save as pdf
        </button>
        <Button href={`mailto:${basics.email}`} variant="ghost">
          email me
        </Button>
      </div>
    </PageHeader>

    <div class="flex max-w-reading flex-col gap-14 md:gap-[72px] print:gap-8">
      <section aria-labelledby="summary-title" class="flex flex-col gap-4">
        <PromptHeading id="summary-title" path="~/resume" command="cat summary.md" />
        <p>{basics.summary}</p>
      </section>

      <section aria-labelledby="work-title" class="flex flex-col gap-5 md:gap-6">
        <PromptHeading id="work-title" path="~/experience" command="git log" />
        <ol class="border-t border-border">
          {work.map((role) => (
            <li class="flex flex-col gap-2 border-b border-border py-6 break-inside-avoid md:grid md:grid-cols-[160px_1fr] md:gap-x-8">
              <p class="font-mono text-[13px] md:text-[15px]">
                <span class:list={role.endDate ? 'text-muted' : 'text-highlight'}>
                  {dateRange(role.startDate, role.endDate)}
                </span>
                {!role.endDate && <span class="text-muted"> HEAD</span>}
              </p>
              <div class="flex flex-col gap-2">
                <h3 class="font-semibold">
                  {role.position}
                  <span class="text-muted"> @ </span>
                  {role.url ? <a href={role.url}>{role.name}</a> : role.name}
                </h3>
                <p class="text-base text-muted">{role.summary}</p>
                {role.highlights.length > 0 && (
                  <ul class="mt-1 flex list-disc flex-col gap-1.5 pl-5 text-base marker:text-muted">
                    {role.highlights.map((highlight) => (
                      <li>{highlight}</li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="skills-title" class="flex flex-col gap-5 md:gap-6">
        <PromptHeading id="skills-title" path="~/skills" command="ls -R" />
        <dl class="flex flex-col gap-5">
          {skills.map((group) => (
            <div class="flex flex-col gap-2 break-inside-avoid md:grid md:grid-cols-[160px_1fr] md:items-baseline md:gap-x-8">
              <dt class="font-mono text-sm text-muted">{group.name}</dt>
              <dd>
                <Flags tags={group.keywords} />
              </dd>
            </div>
          ))}
        </dl>
      </section>

      {education.length > 0 && (
        <section aria-labelledby="edu-title" class="flex flex-col gap-5 md:gap-6">
          <PromptHeading id="edu-title" path="~/education" command="ls" />
          <ul class="border-t border-border">
            {education.map((item) => (
              <li class="flex flex-col gap-1 border-b border-border py-5 break-inside-avoid md:grid md:grid-cols-[160px_1fr] md:gap-x-8">
                <p class="font-mono text-[13px] text-muted md:text-[15px]">
                  {dateRange(item.startDate, item.endDate)}
                </p>
                <div>
                  <h3 class="font-semibold">{`${item.studyType} ${item.area}`}</h3>
                  <p class="text-base text-muted">{item.institution}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {certificates.length > 0 && (
        <section aria-labelledby="certs-title" class="flex flex-col gap-5 md:gap-6">
          <PromptHeading id="certs-title" path="~/certs" command="ls" />
          <ul class="border-t border-border">
            {certificates.map((cert) => (
              <li class="flex flex-col gap-1 border-b border-border py-5 break-inside-avoid md:grid md:grid-cols-[160px_1fr] md:gap-x-8">
                <p class="font-mono text-[13px] text-muted md:text-[15px]">
                  {cert.date ? year(cert.date) : ''}
                </p>
                <div>
                  <h3 class="font-semibold">
                    {cert.url ? <a href={cert.url}>{cert.name}</a> : cert.name}
                  </h3>
                  <p class="text-base text-muted">{cert.issuer}</p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </Container>
</BaseLayout>

<script>
  const button = document.getElementById('print-resume');
  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => window.print());
  }
</script>
