---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHeader from '../components/PageHeader.astro';
import PromptHeading from '../components/PromptHeading.astro';
import WindowFrame from '../components/WindowFrame.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Replace with real content. Keep each list to three or four short items.
const bio = [
  "[Short story, about 150 words in total. How you got into software and what you've been building since.]",
  '[What kinds of problems you like most, and the teams or clients you do your best work with.]',
  "[Something human: what you do when you're not at a keyboard.]",
];

const howIWork = [
  '[A working principle, e.g. "Ship small, measure, then iterate."]',
  '[How you communicate: async updates, written decisions, demos.]',
  '[What you care about in code review and handoff.]',
];

const learning = [
  '[A technology or topic you are learning right now.]',
  '[A book, course or side project in progress.]',
];
---

<BaseLayout
  title="About"
  description={`About ${site.name}: background, how I work and what I'm learning.`}
  footerFile="bio.md"
>
  <Container>
    <PageHeader path="~/about" command="cat bio.md" title="About" lead={site.description} />

    <div class="grid gap-10 md:grid-cols-[minmax(0,720px)_minmax(240px,1fr)] md:gap-14">
      <div class="flex flex-col gap-14 md:gap-[72px]">
        <section aria-label="Bio" class="flex flex-col gap-4 leading-[1.7]">
          {bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>

        <section aria-labelledby="work-title" class="flex flex-col gap-5">
          <PromptHeading id="work-title" path="~/about" command="cat how-i-work.md" />
          <ul class="flex flex-col gap-3">
            {howIWork.map((item) => (
              <li class="flex gap-3">
                <span class="font-mono text-accent" aria-hidden="true">
                  →
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="learning-title" class="flex flex-col gap-5">
          <PromptHeading id="learning-title" path="~/about" command="cat learning.md" />
          <ul class="flex flex-col gap-3">
            {learning.map((item) => (
              <li class="flex gap-3">
                <span class="font-mono text-accent" aria-hidden="true">
                  →
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <!-- Photo: swap the placeholder for an astro:assets <Image> with real alt text. -->
      <aside aria-label="Photo" class="order-first md:order-none">
        <WindowFrame title="~/about/photo.jpg" class="md:sticky md:top-8">
          <div class="flex aspect-[4/5] max-h-[360px] w-full items-center justify-center bg-bg font-mono text-sm text-muted md:max-h-none">
            [photo]
          </div>
        </WindowFrame>
      </aside>
    </div>

    <CtaBand
      id="contact"
      title="Let's build something"
      text={`Hiring for a role or planning a project? ${site.replyTime}`}
      class="my-14 md:my-24"
    >
      <Button href="/contact">get in touch</Button>
    </CtaBand>
  </Container>
</BaseLayout>
