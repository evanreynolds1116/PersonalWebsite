---
import { Picture } from 'astro:assets';
import photo from '../assets/about/evan-reynolds.jpg';
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHeader from '../components/PageHeader.astro';
import WindowFrame from '../components/WindowFrame.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// About 150 words, from the resume. Keep it to three short paragraphs.
const bio = [
  "I'm a software engineer in Nashville. I got into software through Nashville Software School's full-stack program in 2020, then spent two years at Accenture building the pipelines that moved client data into Salesforce, and a year at Momentum Technology shipping backend APIs, where a fraud-detection integration I built drove a 20% revenue increase in its first month.",
  "Today I'm an Application Engineer at HCA Healthcare and the sole engineer behind Badge Pay, a badge-based payment system used by about 146,000 employees across 250+ facilities and paid through payroll. Most days that means Python, SQL and Airflow, and making sure data moves between systems accurately and on time. In my own time, I build full-stack web apps, like the projects on this site.",
  "When I'm not at a keyboard, I'm usually on a golf course, playing hockey, or at a concert.",
];
---

<BaseLayout
  title="About"
  description={`About ${site.name}: background, current work and life outside it.`}
  footerFile="bio.md"
>
  <Container>
    <PageHeader path="~/about" command="cat bio.md" title="About" lead={site.description} />

    <div class="grid gap-10 md:grid-cols-[minmax(0,720px)_minmax(240px,1fr)] md:gap-14">
      <div class="flex flex-col gap-14 md:gap-[72px]">
        <section aria-label="Bio" class="flex flex-col gap-4 leading-[1.7]">
          {bio.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      </div>

      <aside aria-label="Photo" class="order-first md:order-none">
        <WindowFrame title="~/about/photo.jpg" class="md:sticky md:top-8">
          <!-- Cropped to 4:5, framed on the face; on phones capped in height so the bio follows soon. -->
          <Picture
            src={photo}
            alt={`${site.name} smiling outdoors in a plaid overshirt, in black and white.`}
            widths={[360, 720, 1080]}
            sizes="(min-width: 768px) 360px, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="block aspect-[4/5] max-h-[360px] w-full bg-bg object-cover object-[50%_30%] md:max-h-none"
          />
        </WindowFrame>
      </aside>
    </div>

    <CtaBand
      id="contact"
      title="Let's build something"
      text={`Hiring for a role or planning a project? ${site.replyTime}`}
      class="my-14 md:my-24"
    >
      <Button href="/contact">get in touch</Button>
    </CtaBand>
  </Container>
</BaseLayout>
