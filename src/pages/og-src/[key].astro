---
/*
 * Open Graph image templates, one per page in src/lib/pages.ts. Each is a
 * 1200×630 page that scripts/postbuild.mjs screenshots to /og/<key>.png and then
 * deletes, so these HTML files never ship. Always the dark theme.
 */
import type { GetStaticPaths } from 'astro';
import { Font } from 'astro:assets';
import { site } from '../../config/site';
import { getPages, ogKey, type PageEntry } from '../../lib/pages';
import '../../styles/global.css';

export const getStaticPaths = (async () =>
  (await getPages()).map((page) => ({
    params: { key: ogKey(page.path) },
    props: { og: page.og },
  }))) satisfies GetStaticPaths;

interface Props {
  og: PageEntry['og'];
}

const { og } = Astro.props;
const domain = Astro.site?.host ?? `${site.handle}.dev`;
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{`og: ${og.title}`}</title>
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-geist" />
    <style is:global>
      html,
      body {
        width: 1200px;
        height: 630px;
        min-height: 0;
        overflow: hidden;
      }
      .clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
    </style>
  </head>
  <body class="p-12">
    <div class="flex h-full flex-col overflow-hidden rounded-[20px] border-2 border-border bg-surface">
      <div class="flex items-center gap-3 border-b-2 border-border px-7 py-5 font-mono text-[22px] text-muted">
        <span class="size-4 rounded-full bg-border"></span>
        <span class="size-4 rounded-full bg-border"></span>
        <span class="size-4 rounded-full bg-border"></span>
        <span class="ml-3">{`~/${site.handle} — zsh`}</span>
      </div>

      <div class="flex grow flex-col gap-6 px-14 pt-12 pb-10">
        <p class="font-mono text-[28px] text-muted">
          {`${og.dir} $ `}
          <span class="text-text">{og.command}</span>
        </p>
        <h1 class="clamp-2 font-mono text-[72px] leading-[1.08] font-bold tracking-[-0.02em]">
          {og.title}
          <span class="text-accent">_</span>
        </h1>
        <p class="clamp-2 text-[30px] leading-snug text-muted">{og.subtitle}</p>

        <div class="mt-auto flex items-center justify-between font-mono text-[24px]">
          <span class="font-bold">
            <span class="text-accent">~/</span>
            {site.handle}
          </span>
          <span class="flex items-center gap-3 text-highlight">
            <span class="size-3 rounded-full bg-highlight"></span>
            {domain}
          </span>
        </div>
      </div>
    </div>
  </body>
</html>
