---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!-- Phase 1 placeholder. The real home page (hero, projects, experience, services, contact) is Phase 2. -->
<BaseLayout title="Home">
  <Container as="section" aria-labelledby="hero-title" class="py-12 md:py-24">
    <div class="flex max-w-[34em] flex-col gap-5 md:gap-6">
      <p class="font-mono text-[13px] text-highlight md:text-sm">
        [Availability: open to senior roles · taking select freelance work]
      </p>
      <h1
        id="hero-title"
        class="font-mono text-[38px] leading-[1.15] font-bold tracking-[-0.02em] md:text-[56px] md:leading-[1.1]"
      >
        Hi, I'm {site.name}
        <span class="cursor text-accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p class="text-lg text-muted md:text-xl">
        [Home page content arrives in Phase 2. This page exists so the layout, nav, theme toggle and
        footer can be reviewed.]
      </p>
      <div class="flex flex-col gap-3 md:flex-row md:flex-wrap md:gap-4">
        <Button href="/resume">./view-resume</Button>
        <Button href="/contact" variant="ghost">
          start a project →
        </Button>
      </div>
    </div>
  </Container>
</BaseLayout>
