---
import { Font } from 'astro:assets';
import CommandPalette from '../components/CommandPalette.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { site } from '../config/site';
import { ogKey } from '../lib/pages';
import '../styles/global.css';

interface Props {
  /** Page title; the site name is appended. Omit on the home page for "Name · Role". */
  title?: string;
  description?: string;
  /** Passed to the footer status line (e.g. `project-one/README.md`). */
  footerFile?: string;
  noindex?: boolean;
  /** `article` for case studies; `website` otherwise. */
  ogType?: 'website' | 'article';
}

const {
  title,
  description = site.description,
  footerFile,
  noindex = false,
  ogType = 'website',
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
// No trailing slash, matching sitemap.xml.
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, Astro.site);
// Generated after the build by scripts/postbuild.mjs from src/pages/og-src.
const ogImage = new URL(`/og/${ogKey(pathname)}.png`, Astro.site);
const analyticsToken = import.meta.env.PROD ? site.cloudflareAnalyticsToken : undefined;
---

<!doctype html>
<html lang={site.locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Sharing: Open Graph + Twitter/X card. -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${fullTitle}: ${description}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Page-specific head content, e.g. JSON-LD on the home page. -->
    <slot name="head" />

    <!-- Cookie-free analytics, production builds only (token in src/config/site.ts). -->
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}

    <!--
      Runs before first paint so there is no flash of the wrong theme.
      Order: saved choice → OS preference → dark. Keep the storage key in sync with src/lib/theme.ts.
    -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {
          // Storage blocked: fall through to the OS preference.
        }
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
        if (theme === 'light') {
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#fafaf7');
        }
      })();
    </script>
    <!-- Preload only the faces used above the fold: the mono headings and the body text. -->
    <Font cssVariable="--font-jetbrains-mono" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }]} />

    <!-- Without JS, show the phone menu links inline and hide controls that need JS. -->
    <noscript>
      <style>
        .theme-toggle,
        #menu-toggle {
          display: none !important;
        }
        @media (width < 48rem) {
          #mobile-menu {
            display: block !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-accent px-4 py-3 font-mono text-[15px] font-bold text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      skip to content
    </a>
    <Nav />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer file={footerFile} />
    <CommandPalette />
  </body>
</html>
